-- Функции читов

-- Aimbot
RunService.RenderStepped:Connect(function()
    -- Aimbot
    if Settings.Aimbot and Settings.Target and Settings.Target.Character then
        local HRP = Settings.Target.Character:FindFirstChild("HumanoidRootPart")
        if HRP then
            local ScreenPoint = Camera:WorldToScreenPoint(HRP.Position)
            local MousePos = Vector2.new(Mouse.X, Mouse.Y)
            local Distance = (ScreenPoint - MousePos).Magnitude
            if Distance < Settings.FOVSize then
                local LookVector = (HRP.Position - Camera.CFrame.Position).Unit
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, HRP.Position + Vector3.new(0, 1, 0))
            end
        end
    end

    -- ESP
    if Settings.ESP then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local HRP = p.Character:FindFirstChild("HumanoidRootPart")
                if HRP then
                    local ScreenPoint = Camera:WorldToScreenPoint(HRP.Position)
                    if ScreenPoint.Z > 0 then
                        -- Рисуем через BillboardGui
                        if not p.Character:FindFirstChild("ESP") then
                            local Billboard = Instance.new("BillboardGui")
                            Billboard.Name = "ESP"
                            Billboard.Size = UDim2.new(0, 100, 0, 30)
                            Billboard.AlwaysOnTop = true
                            Billboard.Adornee = HRP
                            Billboard.Parent = p.Character

                            local Frame = Instance.new("Frame")
                            Frame.Size = UDim2.new(1, 0, 1, 0)
                            Frame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                            Frame.BackgroundTransparency = 0.5
                            Frame.BorderSizePixel = 2
                            Frame.BorderColor3 = Color3.fromRGB(255, 255, 255)
                            Frame.Parent = Billboard

                            local NameLabel = Instance.new("TextLabel")
                            NameLabel.Size = UDim2.new(1, 0, 0.5, 0)
                            NameLabel.BackgroundTransparency = 1
                            NameLabel.Text = p.Name
                            NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                            NameLabel.TextSize = 12
                            NameLabel.Font = Enum.Font.GothamBold
                            NameLabel.Parent = Frame
                        end
                    end
                end
            end
        end
    else
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("ESP") then
                p.Character.ESP:Destroy()
            end
        end
    end

    -- Triggerbot
    if Settings.Triggerbot and Settings.Target and Settings.Target.Character then
        local HRP = Settings.Target.Character:FindFirstChild("HumanoidRootPart")
        if HRP then
            local ScreenPoint = Camera:WorldToScreenPoint(HRP.Position)
            local MousePos = Vector2.new(Mouse.X, Mouse.Y)
            local Distance = (Vector2.new(ScreenPoint.X, ScreenPoint.Y) - MousePos).Magnitude
            if Distance < 50 then
                mouse1click()
            end
        end
    end

    -- Hitboxes
    if Settings.Hitboxes then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local HRP = p.Character:FindFirstChild("HumanoidRootPart")
                if HRP then
                    HRP.Size = Vector3.new(10, 10, 10)
                    HRP.Transparency = 0.5
                    HRP.CanCollide = false
                end
            end
        end
    end

    -- Fling
    if Settings.Fling and Settings.Target and Settings.Target.Character and LP.Character then
        local R = LP.Character:FindFirstChild("HumanoidRootPart")
        local TR = Settings.Target.Character:FindFirstChild("HumanoidRootPart")
        if R and TR then
            R.CFrame = TR.CFrame * CFrame.new(0, 0, 3)
            R.Velocity = Vector3.new(0, 500, 0)
            R.AngularVelocity = Vector3.new(0, 1000, 0)
            TR.Velocity = Vector3.new(0, 1000, 0)
            TR.AssemblyLinearVelocity = Vector3.new(0, 1000, 0)
        end
    end

    -- Невидимость
    if Settings.Invisible and LP.Character then
        for _, v in ipairs(LP.Character:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Transparency = 1
                v.CanCollide = false
            end
            if v:IsA("Accessory") then
                v.Handle.Transparency = 1
            end
        end
    end

    -- Слежка
    if Settings.Spectate and Settings.Target and Settings.Target.Character then
        local HRP = Settings.Target.Character:FindFirstChild("HumanoidRootPart")
        if HRP then
            Camera.CameraSubject = HRP
        end
    end
end)

-- Бесконечные прыжки
